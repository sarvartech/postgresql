# ---- TUNING (Control-node misoli, 2GB RAM / 2 CPU) ----
# Bu faylni /etc/postgresql/17/main/postgresql.conf ga QO'SHING (append),
# FAQAT tuning qilinadigan serverda. Test-node (baseline) ga tegmang.
#
# Boshqa RAM/CPU uchun qiymatlarni ../../docs/03-formulas.md dagi
# formulalar asosida qayta hisoblang.

shared_buffers = 480MB
effective_cache_size = 1400MB
work_mem = 8MB
maintenance_work_mem = 128MB
wal_buffers = 16MB
min_wal_size = 512MB
max_wal_size = 2GB
checkpoint_completion_target = 0.9
random_page_cost = 1.1
effective_io_concurrency = 200
default_statistics_target = 100

# DIQQAT: max_connections ni pgbench test rejangizga mos tanlang!
# Birinchi testimizda 50 qilib qo'yilgan edi va -c 100 bilan test qilinganda
# "too many clients already" xatosi chiqdi (docs/04-production-pitfalls.md
# ga qarang). Shu sababli real ilova/test ehtiyojiga mos qiymat tanlang,
# yoki PgBouncer kabi connection pooler ishlating.
max_connections = 200

log_min_duration_statement = 200
shared_preload_libraries = 'pg_stat_statements'
